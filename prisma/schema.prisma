generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model blocks {
  id         Int    @id @default(autoincrement())
  block_type String
  data       Json?
}

model projects {
  id         Int               @id @default(autoincrement())
  name       String
  video      String?
  text       String
  importance Int
  statusId   Int
  link       String?
  githubLink String
  categoryId Int
  preview    String
  category   projects_category @relation(fields: [categoryId], references: [id], map: "projects_category_fkey")
  status     projects_status   @relation(fields: [statusId], references: [id], map: "projects_status_fkey")
  img        projects_images[]
  skills     skills[]          @relation("projectsToskills")
}

model projects_images {
  id        Int      @id @default(autoincrement())
  img       String
  projectId Int
  project   projects @relation(fields: [projectId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "projects_images_projectId_fkey")

  @@index([projectId])
}

model projects_status {
  id       Int        @id @default(autoincrement())
  name     String
  img      String
  projects projects[]
}

model projects_category {
  id       Int        @id @default(autoincrement())
  name     String
  projects projects[]
}

model skills {
  id         Int        @id @default(autoincrement())
  name       String
  img        String
  text       String
  importance Int
  projects   projects[] @relation("projectsToskills")
}

model contacts {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
